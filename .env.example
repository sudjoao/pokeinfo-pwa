# Conta Google e sincronização (opcional). Sem estas variáveis o app funciona igual, só no aparelho,
# e o botão de conta não aparece no cabeçalho. Copie para .env.local (fora do git).
# Valores em Supabase > Project Settings > API (a chave publicável é pública por design: quem
# protege os dados é a Row Level Security da tabela user_collections).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
